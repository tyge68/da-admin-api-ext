  "description": "Chrome MV3 side-panel extension to manage AEM (aem.live) Admin API keys, secrets and webhooks for a da.live site.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && ENTRY=background vite build",
