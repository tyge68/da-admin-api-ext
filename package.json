    "test": "vitest run"
  },
  "dependencies": {
    "@react-spectrum/s2": "^1.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lightningcss": "^1.33.0",
    "typescript": "^5.6.3",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
